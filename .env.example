# Variables opcionales de `docker compose up` (copie este archivo a `.env` solo si necesita cambiar algo; sin él todo funciona).
# NO ponga aquí claves: las genera el servicio `init` en credenciales/ (ignorada por git).

# Acceso desde OTRO equipo (no desde localhost): IP o nombre que debe llevar el certificado del gateway.
# Si ya se generó el certificado, bórrelo (credenciales/gateway.crt y gateway.key) o use `python3 scripts/certificados.py --rotar --ip <IP>`.
#GATEWAY_IP_EXTRA=192.168.1.50

# Usuario y clave de las bases de las sedes y de la réplica (laboratorio; los valores por defecto sirven).
#POSTGRES_USER=admin
#POSTGRES_PASSWORD=admin
#REPLICATION_PASSWORD=repl_secret
